      "Grok": {
        "RequestsPerMinute": 10,
        "BurstLimit": 0
      },
      "OpenCodeZen": {
        "RequestsPerMinute": 20,
        "BurstLimit": 0
      }
    }
  },
  "FrontendConfig": {
    "MaxLevels": 5,
    "CompletionThreshold": 10,
    "DefaultTimeout": 30000,
    "DefaultRetries": 2,
    "RetryBackoffBaseMs": 300,
    "MaxNotifications": 50,
    "ToastDismissMs": 5000,
    "DebouncePersistMs": 300,
    "ReplaySpeeds": [
      0.5,
      1,
      2,
      4
    ],
    "ReplayBaseDelayMs": 1500,
    "DefaultCycleTotalTurns": 5,
    "ChainDelayMs": 1500,
    "SavedIndicatorMs": 1500,
    "VerifyChainIndicatorMs": 3000,
    "CopiedIndicatorMs": 2000,
