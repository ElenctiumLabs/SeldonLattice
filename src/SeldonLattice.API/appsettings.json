    "MaxWaitSeconds": 60,
    "Providers": {
      "Gemini": {
        "RequestsPerMinute": 15,
        "BurstLimit": 0
      },
      "Groq": {
        "RequestsPerMinute": 30,
        "BurstLimit": 0
