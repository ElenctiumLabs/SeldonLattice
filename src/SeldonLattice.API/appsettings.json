        "Content-Type",
        "Authorization",
        "X-Request-Id",
        "X-Admin-Key"
      ],
      "AllowCredentials": true
    }
  },
  "Sentinel": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8080",
    "ApiKey": "seldon-local-dev-key",
    "Pricing": {
      "InputPer1K": 0.0001,
      "OutputPer1K": 0.0003
    },
    "Agent": {
      "ExternalId": "seldon-lattice",
      "Name": "Seldon Lattice",
      "Description": "Dialectical reasoning engine with multi-agent philosophical synthesis"
    },
    "Security": {
      "Enabled": true,
      "FallbackToLocal": true
    },
    "Tracing": {
      "Enabled": true,
      "IngestOnSessionEnd": true
    }
  },
  "ApiKeys": [
    {
      "Key": "dev-key-admin",
      "Roles": [
        "admin"
      ]
    },
    {
      "Key": "dev-key-reader",
      "Roles": [
