    "FitViewAllPadding": 0.15,
    "FitViewAllDuration": 600,
    "FitViewLevelPadding": 0.65,
    "FitViewLevelDuration": 600,
    "FitViewShortcutPadding": 0.65,
    "FitViewShortcutDuration": 400,
    "ZoomDuration": 200,
    "BackdropStars": 30,
    "BackdropTargetFps": 5,
    "BackdropTimeStep": 0.015,
