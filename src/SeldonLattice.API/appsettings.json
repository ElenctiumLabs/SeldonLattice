      "AllowedOrigins": [
        "http://localhost:5174",
        "http://127.0.0.1:5174",
        "http://localhost:3000"
      ],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
