    "LayoutHelicalInterjectionSpacing": 60,
    "LayoutHelicalLevelGap": 220,
    "LayoutHelicalStackOffset": 100,
    "LayoutClusterQuestionRadius": 110,
    "LayoutClusterDebateRadius": 90,
    "LayoutClusterVerticalOffset": 70,
    "LayoutClusterChildGap": 300,
    "LayoutDuplicateSpacing": 45,
    "LayoutLevelRotation": 0.8,
    "LayoutRingSpacing": 90,
    "LayoutRingMinRadius": 110,
    "CycleDialSize": 128,
    "CycleDialRadius": 50,
    "DefaultQualityThreshold": 0.7,
    "DefaultMaxDepth": 10,
    "DefaultAutoArchiveDays": 30,
    "DefaultRateLimit": 100,
    "Version": "0.1.0",
    "Agents": [
      "proposer",
      "skeptic",
      "mediator"
    ]
  },
  "Settings": {
    "Providers": [
      "OpenAI",
      "OpenAITrained",
      "LlamaCpp",
      "OpenCodeZen",
      "Gemini",
      "Grok",
      "Groq",
      "Ollama"
    ]
  },
  "Dialectics": {
    "AscentScorerMode": "Spec",
    "AscentBetweennessFloor": 0.6
  },
  "Embeddings": {
    "Validation": {
      "Enabled": true,
      "ExpectedDimension": 768,
      "ExpectedL2Norm": 1.0,
      "NormTolerance": 0.01,
      "ThrowOnShapeFailure": false,
      "SentinelText": "What is philosophy??",
      "SentinelReferencePath": "embedding_sentinel.json",
      "MinSentinelCosine": 0.99,
      "ThrowOnContinuityFailure": false
    }
  },
  "QualityGates": {
    "OptimalLengthMin": 60,
    "OptimalLengthMax": 200,
    "AcceptableLengthMax": 300,
    "PaddedLengthMax": 450,
    "BloatedLengthMax": 800
  }
