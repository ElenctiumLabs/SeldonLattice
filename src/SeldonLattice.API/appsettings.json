        "stream"
      ]
    },
    {
      "Key": "dev-key-settings",
      "Roles": [
        "settings"
      ]
    },
    {
      "Key": "dev-key-full",
      "Roles": [
        "reader",
        "writer",
        "dialectician",
        "stream",
        "ingest",
        "settings"
      ]
    }
