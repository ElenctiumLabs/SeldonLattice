# Development environment for the Vite dev server.
# Copy this file to .env and adjust as needed. .env is gitignored.

# The Vite dev proxy injects this as the Authorization header on /api requests.
# It must match one of the ApiKeys in src/SeldonLattice.API/appsettings.json.
# The default below is the committed dev key (dev-key-full).
VITE_DEV_API_KEY=ApiKey dev-key-full

# The API the Vite dev proxy forwards /api to.
VITE_DEV_PROXY_TARGET=http://localhost:5050
